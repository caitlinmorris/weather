# flyctl launch added from .gitignore
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache

# Databases and any captured data live outside version control, always.
**/data
**/*.db
**/*.sqlite

# Raw labeled sessions must be synthetic-ified before commit; keep originals out.
**/presence/eval/labels/raw

# API keys live in .env, never in version control.
**/.env

# Generated pages embed real derived state; rebuild from template instead.
**/presence/render/ambient.html

# Local extractor-output notes contain T0 evidence strings. Never commit.
**/v1-outputs-*.md
**/v1_outputs*.md

# flyctl launch added from .pytest_cache/.gitignore
# Created by pytest automatically.
.pytest_cache/**/*

# flyctl launch added from .venv/.gitignore
# Created by venv; see https://docs.python.org/3/library/venv.html
.venv/**/*
fly.toml
