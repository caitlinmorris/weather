.venv/
__pycache__/
*.pyc
.pytest_cache/

# Databases and any captured data live outside version control, always.
data/
*.db
*.sqlite

# Raw labeled sessions must be synthetic-ified before commit; keep originals out.
presence/eval/labels/raw/

# API keys live in .env, never in version control.
.env

# Generated pages embed real derived state; rebuild from template instead.
presence/render/ambient.html

# Local extractor-output notes contain T0 evidence strings. Never commit.
v1-outputs-*.md
v1_outputs*.md

# Personal fork ideas — deliberately not part of this project
fork-notes/

# per-board wrangler configs are generated
presence/relay/worker/wrangler.*.toml
!presence/relay/worker/wrangler.toml

# built kits contain real keys — never commit
dist/

# per-board token-hash files (hashes only, never tokens)
presence/relay/worker/hashes.*.json

# personal writeups (website/substack) — not repo material
docs/writeups/

# macOS Finder metadata
.DS_Store

# probe outputs from testers (structure-only, but keep local)
docs/codex-probes-output.txt
